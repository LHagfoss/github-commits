{
  "name": "@lhagfoss/github-commits",
  "version": "0.1.0",
  "description": "A responsive GitHub contribution graph for React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean",
    "dev": "tsup src/index.tsx --format esm --dts --watch",
    "check": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun run build"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LHagfoss/github-commits.git"
  },
  "keywords": ["github", "commits", "contributions", "react", "component", "graph"],
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
